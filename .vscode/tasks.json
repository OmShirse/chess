{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build active file",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-Wall",
                "-Wextra",
                "-std=c17",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "gcc build active file, debug symbols on"
        },
        {
            "type": "shell",
            "label": "Run active file",
            "command": "${fileDirname}/${fileBasenameNoExtension}",
            "dependsOn": "Build active file",
            "problemMatcher": [],
            "detail": "build then run"
        },
        {
            "type": "shell",
            "label": "Build (Makefile)",
            "command": "make",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "detail": "runs make in project root, needs Makefile"
        },
        {
            "type": "shell",
            "label": "Clean (Makefile)",
            "command": "make",
            "args": ["clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "runs make clean"
        }
    ]
}